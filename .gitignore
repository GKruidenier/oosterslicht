# Bronfoto's: originelen uit de camera, geen websitebestanden. Ze blijven op
# schijf staan, maar horen niet in de repository — de site gebruikt de
# geoptimaliseerde .webp-versies in assets/img.
fotos_claude_website/

# Originelen waarvan een geoptimaliseerde .webp in assets/img staat. Ze zijn
# hierheen verplaatst, niet verwijderd; ONGEBRUIKTE-BESTANDEN.txt somt op
# welke. De site vraagt geen van deze bestanden op.
_originelen/

# Gedownloade skill (impeccable). Externe code van
# https://github.com/pbakaus/impeccable, opnieuw op te halen wanneer nodig.
# Alleen deze map, en niet .claude/skills/ als geheel: de testsite-skill is
# eigen werk en hoort wel in de repository. Die stond eerder ook buiten
# versiebeheer, waardoor een fix aan upload.sh bij een verse checkout
# verdween.
.claude/skills/impeccable/

# Werkbestanden van diezelfde skill: critique-rapporten en momentopnamen.
# Nuttig tijdens het werken, geen onderdeel van de site.
.impeccable/

# Tijdelijke werkbestanden
*.tmp
.lampdata.json
.lampblokken.json

# Systeemrommel
.DS_Store
Thumbs.db
desktop.ini

# Tijdelijke vergelijkingspagina voor de lettertypekeuze; mag weg na de keuze.
_fontkeuze/

# Schetsen voor de ontwerprichting; mag weg zodra er gekozen is.
_schetsen/

# Werktabel van seo.py: telkens opnieuw af te leiden uit de HTML met
# "python seo.py export". De HTML is de bron, deze tabel alleen de
# invoerhulp om alle titels naast elkaar te kunnen bewerken.
seo.tsv
